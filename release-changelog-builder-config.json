{
  "categories": [
    {
      "title": "## Added",
      "labels": ["feat", "feature"]
    },
    {
      "title": "## Fixed",
      "labels": ["fix", "bug"]
    },
    {
      "title": "## Documentation",
      "labels": ["docs", "documentation"]
    },
    {
      "title": "## Changed",
      "labels": ["chore", "refactor", "perf", "test", "ci", "build", "style"]
    },
    {
      "title": "## Tests",
      "labels": ["type: test"]
    }
  ],
  "ignore_labels": ["ignore"],
  "sort": "ASC",
  "template": "#{{CATEGORIZED_COUNT}} changes since #{{FROM_TAG}}\n\n#{{CHANGELOG}}\n\n## Other Updates\n\n#{{UNCATEGORIZED}}\n",
  "pr_template": "- #{{TITLE}} (##{{NUMBER}})",
  "commit_template": "- #{{TITLE}} (#{{MERGE_SHA}})",
  "empty_template": "See git log or compare with previous tag for changes.",
  "label_extractor": [
    {
      "pattern": "^([a-z]+)(\\(.+\\))?:",
      "on_property": "title",
      "target": "$1"
    }
  ],
  "max_tags_to_fetch": 200,
  "max_pull_requests": 250,
  "max_back_track_time_days": 90,
  "tag_resolver": {
    "method": "semver"
  }
}
